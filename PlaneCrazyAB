local function switchTab(idx)
    activeTab = idx
    for i, btn in ipairs(tabBtns) do
        local on = (i == idx)
        tween(btn, {BackgroundColor3 = on and CLR.tabOn or CLR.tabOff})
        btn.TextColor3 = on and CLR.text or CLR.subtext
    end
    for i, page in ipairs(tabPages) do
        page.Visible = (i == idx)
    end
end

